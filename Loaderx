
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local ExistingGui = CoreGui:FindFirstChild("ReaperEarlyLoadingNotify")
if ExistingGui then
    ExistingGui:Destroy()
end

local NotificationGui = Instance.new("ScreenGui")
NotificationGui.Name = "ReaperEarlyLoadingNotify"
NotificationGui.ResetOnSpawn = false
NotificationGui.IgnoreGuiInset = true
NotificationGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
NotificationGui.Parent = CoreGui

local TopPosition = UDim2.new(0.5, 0, 0, 32)
local MiddlePosition = UDim2.new(0.5, 0, 0, 100)
local HiddenPosition = UDim2.new(0.5, 0, 0, 155)

local function CreateNotification(Message)
    local NotificationFrame = Instance.new("Frame")
    NotificationFrame.Name = "Notification"
    NotificationFrame.Size = UDim2.new(0, 340, 0, 60)
    NotificationFrame.AnchorPoint = Vector2.new(0.5, 0)
    NotificationFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
    NotificationFrame.BackgroundTransparency = 0.28
    NotificationFrame.BorderSizePixel = 0
    NotificationFrame.ClipsDescendants = true
    NotificationFrame.ZIndex = 1000
    NotificationFrame.Parent = NotificationGui

    local FrameCorner = Instance.new("UICorner")
    FrameCorner.CornerRadius = UDim.new(0, 14)
    FrameCorner.Parent = NotificationFrame

    local FrameStroke = Instance.new("UIStroke")
    FrameStroke.Color = Color3.fromRGB(239, 68, 68)
    FrameStroke.Thickness = 1
    FrameStroke.Transparency = 0.2
    FrameStroke.Parent = NotificationFrame

    local IconBackground = Instance.new("Frame")
    IconBackground.Size = UDim2.fromOffset(42, 42)
    IconBackground.Position = UDim2.new(0, 8, 0.5, 0)
    IconBackground.AnchorPoint = Vector2.new(0, 0.5)
    IconBackground.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
    IconBackground.BackgroundTransparency = 0.84
    IconBackground.BorderSizePixel = 0
    IconBackground.ZIndex = 1001
    IconBackground.Parent = NotificationFrame

    local IconCorner = Instance.new("UICorner")
    IconCorner.CornerRadius = UDim.new(1, 0)
    IconCorner.Parent = IconBackground

    local NotificationIcon = Instance.new("ImageLabel")
    NotificationIcon.Size = UDim2.fromOffset(36, 36)
    NotificationIcon.Position = UDim2.new(0, 11, 0.5, 0)
    NotificationIcon.AnchorPoint = Vector2.new(0, 0.5)
    NotificationIcon.BackgroundTransparency = 1
    NotificationIcon.Image = "rbxassetid://131279093559313"
    NotificationIcon.ScaleType = Enum.ScaleType.Fit
    NotificationIcon.ZIndex = 1002
    NotificationIcon.Parent = NotificationFrame

    local MessageLabel = Instance.new("TextLabel")
    MessageLabel.Size = UDim2.new(1, -64, 1, 0)
    MessageLabel.Position = UDim2.new(0, 60, 0, 0)
    MessageLabel.BackgroundTransparency = 1
    MessageLabel.Text = Message
    MessageLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    MessageLabel.TextSize = 13
    MessageLabel.Font = Enum.Font.GothamMedium
    MessageLabel.TextXAlignment = Enum.TextXAlignment.Left
    MessageLabel.TextYAlignment = Enum.TextYAlignment.Center
    MessageLabel.TextWrapped = true
    MessageLabel.ZIndex = 1002
    MessageLabel.Parent = NotificationFrame

    return {
        Frame = NotificationFrame,
        Label = MessageLabel,
        Icon = NotificationIcon,
        IconBackground = IconBackground,
        Stroke = FrameStroke
    }
end

local function TweenObject(Object, Duration, Properties)
    local Tween = TweenService:Create(
        Object,
        TweenInfo.new(Duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        Properties
    )

    Tween:Play()
    return Tween
end

local function RemoveNotification(Notification)
    if not Notification or not Notification.Frame.Parent then
        return
    end

    TweenObject(Notification.Frame, 0.5, {
        Position = UDim2.new(0.5, 0, 0, -30),
        BackgroundTransparency = 1
    })

    TweenObject(Notification.Label, 0.4, {
        TextTransparency = 1
    })

    TweenObject(Notification.Icon, 0.4, {
        ImageTransparency = 1
    })

    TweenObject(Notification.IconBackground, 0.4, {
        BackgroundTransparency = 1
    })

    TweenObject(Notification.Stroke, 0.4, {
        Transparency = 1
    })

    task.delay(0.55, function()
        if Notification.Frame and Notification.Frame.Parent then
            Notification.Frame:Destroy()
        end
    end)
end

task.spawn(function()
    local FirstNotification = CreateNotification(
        "Please wait for the script to load."
    )

    FirstNotification.Frame.Position = HiddenPosition

    TweenObject(FirstNotification.Frame, 0.7, {
        Position = TopPosition
    })

    task.delay(1, function()
        local SecondNotification = CreateNotification(
            "มึงก็รอสิไอสัส กำลังโหลด"
        )

        SecondNotification.Frame.Position = HiddenPosition

        TweenObject(SecondNotification.Frame, 0.7, {
            Position = MiddlePosition
        })

        task.delay(4, function()
            RemoveNotification(FirstNotification)

            task.delay(0.55, function()
                if SecondNotification.Frame.Parent then
                    TweenObject(SecondNotification.Frame, 0.7, {
                        Position = TopPosition
                    })
                end

                task.delay(1, function()
                    RemoveNotification(SecondNotification)

                    task.delay(0.7, function()
                        if NotificationGui and NotificationGui.Parent then
                            NotificationGui:Destroy()
                        end
                    end)
                end)
            end)
        end)
    end)
end)



